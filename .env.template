# =============================================================================
# DeepResearch Agent (Finance Edition) — Multi-backend LLM configuration file
# =============================================================================
# Usage:
#   1. Copy this file to .env.local (ignored by .gitignore, so it will not be committed to Git)
#   2. Fill in your real API keys
#   3. It is read automatically at startup; no source changes needed
# =============================================================================
#
# [Design principles]
#   .env stores only "connection information" (API key, Base URL, model name).
#   Sampling parameters (temperature, max_tokens) are configured per module in configs/default.yaml,
#   and dynamically overridden via ModelRouter.create_backend(name, temperature=..., max_tokens=...).
# =============================================================================

# ---------------------------------------------------------------------------
# LangSmith tracing configuration (optional)
# ---------------------------------------------------------------------------
# Set to true to enable tracing; false disables it entirely (zero overhead)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_ss_key_here
LANGSMITH_PROJECT=xxx
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # default; usually no need to change

# ---------------------------------------------------------------------------
# Default backend selection
# ---------------------------------------------------------------------------
# Allowed values: claude | deepseek | vllm | openai | mimo
# If unset, claude is used by default
DEFAULT_LLM_BACKEND=claude

# ---------------------------------------------------------------------------
# Anthropic Claude API (default backend)
# ---------------------------------------------------------------------------
# Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here
# Default model (each module can be specified separately under backend_sampling.modules in configs/default.yaml)
CLAUDE_MODEL=claude-sonnet-5-5
# Only needed when accessing through a gateway/proxy
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# CLAUDE_MAX_RETRIES=3          # SDK built-in exponential-backoff retry (429/5xx/network)
# CLAUDE_TIMEOUT=600
# CLAUDE_MAX_INPUT_CHARS=600000 # Oldest turns are dropped beyond this (Claude context is 1M tokens, far larger than the original 16K limit)

# ---------------------------------------------------------------------------
# DeepSeek API configuration (optional, for comparison experiments only)
# ---------------------------------------------------------------------------
# DEEPSEEK_API_KEY=your_ss_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Local vLLM configuration (connection information only)
# ---------------------------------------------------------------------------
# VLLM_API_KEY=EMPTY
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---------------------------------------------------------------------------
# OpenAI / other OpenAI-compatible APIs (optional)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Xiaomi MiMo 2.5 Pro (OpenAI-compatible)
# ---------------------------------------------------------------------------
# MIMO_API_KEY=your_ss_key_here
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5-pro

# ---------------------------------------------------------------------------
# SEC EDGAR (financial-report research scenarios)
# ---------------------------------------------------------------------------
# The SEC requires all automated requests to carry a contactable identity in the User-Agent, otherwise they get a 403.
# Format: "company or name email", for example "Iris Research you@example.com"
SEC_USER_AGENT=your_name your_email@example.com

# Web Search tool configuration
# ---------------------------------------------------------------------------
# Backend choice: serpapi | bing | mataso | bocha (default serpapi; both are accessible from mainland China)
SEARCH_BACKEND=bocha

# --- SerpAPI configuration (✅ accessible from mainland China, 100 free calls per month)---
# Register at https://serpapi.com to get a key
# SERPAPI_KEY=your_ss_key_here
# SERPAPI_ENDPOINT=https://serpapi.com/search

# --- Bing Search API configuration (✅ stable in mainland China, requires an Azure subscription)---
# Create a "Bing Search v7" resource in the Azure Portal to get a key
#BING_SEARCH_KEY=your_bing_key_here
#BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
# ---------------------------------------------------------------------------
# Bocha AI search configuration (✅ best in mainland China, optimized for AI Agents)
# ---------------------------------------------------------------------------
BOCHA_API_KEY=your_ss_key_here
BOCHA_API_ENDPOINT=https://api.bochaai.com/v1/web-search

# ---------------------------------------------------------------------------
# Metaso AI search configuration (✅ strong Chinese semantics, supports multi-round research mode)
# ---------------------------------------------------------------------------
# METASO_API_KEY=your_ss_key_here
# METASO_API_ENDPOINT=https://metaso.cn/api/open/search/v2


# ---------------------------------------------------------------------------
# ArXiv / paper reading tool configuration
# ---------------------------------------------------------------------------
# Backend choice: semantic_scholar | arxiv | openalex (default openalex, accessible from mainland China)
# Why is openalex the default?
#   - semantic_scholar: ✅ reachable from mainland China, covers 200M+ papers, free
#   - arxiv:            ❌ blocked in mainland China, VPN required
#   - openalex:         ✅ reachable from mainland China, completely free, no key needed
ARXIV_READER_BACKEND=openalex

# --- Semantic Scholar configuration (✅ reachable from mainland China, recommended)---
# Apply for a free key (optional; without a key there is a rate limit):
# https://www.semanticscholar.org/product/api#api-key-form
# SEMANTIC_SCHOLAR_API_KEY=your_ss_key_here
# --- ArXiv configuration (❌ blocked in mainland China unless you have a VPN)---
# ARXIV_API_ENDPOINT=http://export.arxiv.org/api/query
# --- OpenAlex configuration (✅ reachable from mainland China, completely free, no key needed) ---
# Providing an email raises the rate limit, but it works without one
# https://docs.openalex.org/
OPENALEX_EMAIL=your_email_here


# ---------------------------------------------------------------------------
# Browser tool configuration (✅ plain HTTP fetching; availability in mainland China depends on the target site)
# ---------------------------------------------------------------------------
# HTTP request timeout (seconds)
BROWSER_TIMEOUT=15

# Custom User-Agent (some websites require a specific UA)
# BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ---------------------------------------------------------------------------
# Code Sandbox tool configuration (✅ purely local, no network)
# ---------------------------------------------------------------------------
# Default execution timeout (seconds)
CODE_SANDBOX_TIMEOUT=10

# ---------------------------------------------------------------------------
# File Reader tool configuration (✅ purely local, no network)
# ---------------------------------------------------------------------------
# Sandbox root directory: only files under this directory may be read (strongly recommended in production)
FILE_READER_ALLOWED_BASE_DIR=/path/to/allowed/data

# Maximum file size (bytes)
FILE_READER_MAX_FILE_SIZE=10485760

# HuggingFace mirror for mainland China (avoids timeouts connecting to huggingface.co, and supports downloading new models)
HF_ENDPOINT=https://hf-mirror.com

